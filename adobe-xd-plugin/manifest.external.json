{
  "manifestVersion": 4,
  "id": "com.mcpadobe.xd.bridge",
  "name": "MCP Adobe XD Bridge",
  "version": "0.4.0",
  "main": "main.external.js",
  "host": {
    "app": "XD",
    "minVersion": "40.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "mcpAdobeConnect",
      "label": {
        "default": "MCP Adobe Connect"
      },
      "shortcut": {
        "win": "Ctrl+Alt+Shift+9",
        "mac": "Cmd+Alt+Shift+9"
      }
    },
    {
      "type": "command",
      "id": "mcpAdobeApply",
      "label": {
        "default": "MCP Adobe Apply"
      },
      "shortcut": {
        "win": "Ctrl+Alt+Shift+8",
        "mac": "Cmd+Alt+Shift+8"
      }
    },
    {
      "type": "panel",
      "id": "mcpAdobeBridge",
      "label": {
        "default": "MCP Adobe Bridge"
      }
    }
  ]
}

# Copy the values you need into your process/service environment.
# Do not put real secrets in this file or commit them to Git.

MCP_ADOBE_OAUTH_ISSUER_URL=https://auth.example.com
MCP_ADOBE_OAUTH_RESOURCE_URL=https://creative.example.com/mcp
MCP_ADOBE_OAUTH_INTROSPECTION_ENDPOINT=https://auth.example.com/oauth/introspect
MCP_ADOBE_OAUTH_REQUIRED_SCOPES=creative:access

# Optional when the authorization server requires resource-server credentials
# for RFC 7662 token introspection. Store the real secret in a secret manager or
# protected service environment, not in the repository.
# MCP_ADOBE_OAUTH_CLIENT_ID=mcp-adobe-resource-server
# MCP_ADOBE_OAUTH_CLIENT_SECRET=REPLACE_OUTSIDE_GIT

# Default is true. Set false only when the IdP uses a different audience model
# and the verifier/deployment validates that audience externally.
# MCP_ADOBE_OAUTH_VALIDATE_RESOURCE=true
